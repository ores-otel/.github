{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "fleetVersion": "ores.otel.repository-fleet/v2",
  "visibility": "public",
  "canonical": {
    "organization": "ores-otel",
    "name": "ores.otel.log",
    "description": "Canonical polyglot structured logging, OpenTelemetry, Loki, Prometheus, Grafana, and Supabase contracts",
    "role": "primary",
    "autoInit": false,
    "mirrorFrom": "ORESoftware/next-loggers.ts"
  },
  "sharedRepositories": [
    {
      "organization": "ores-otel",
      "name": "ores-interfaces",
      "description": "Canonical polyglot identity, authorization, request, error, and security-event contracts for OreSoftware organizations",
      "role": "cross-organization-contract-authority",
      "autoInit": true,
      "template": "repository-templates/ores-interfaces",
      "topics": ["interfaces", "contracts", "json-schema", "rust", "typescript", "golang", "python", "dart", "java", "swift", "zed-pkg"]
    },
    {
      "organization": "ores-otel",
      "name": "ores-lib-core",
      "description": "Polyglot security, redaction, correlation, and logging adapters shared across OreSoftware services and clients",
      "role": "cross-organization-core-library",
      "autoInit": true,
      "template": "repository-templates/ores-lib-core",
      "topics": ["core-library", "security", "redaction", "opentelemetry", "logging", "rust", "typescript", "golang", "python", "zed-pkg"]
    }
  ],
  "legacy": {
    "repository": "ORESoftware/next-loggers.ts",
    "role": "compatibility-mirror",
    "mustRemainReadable": true,
    "mustPreserveHistory": true
  },
  "testOrganization": "ores-otel-test",
  "promotionRequirements": {
    "minimumRepositories": 10,
    "minimumLanguages": 7,
    "mustTestCanonicalAndLegacy": true,
    "requireExactHeadChecks": true,
    "requireNoMonkeyPatching": true,
    "requireSharedRepositoryTemplates": true,
    "requireSecretScan": true
  },
  "testRepositories": [
    {"name":"ores-otel-log-nodejs-test","language":"nodejs","runtime":"Node.js 18/20/22/24, Bun, and Deno","toolchain":"npm and runtime CLIs","testCommand":"npm ci && npm test"},
    {"name":"ores-otel-log-browser-test","language":"browser","runtime":"Chromium and workerd","toolchain":"Playwright and workerd","testCommand":"npm ci && npm run test:browser && npm run test:workerd"},
    {"name":"ores-otel-log-python-test","language":"python","runtime":"CPython 3.11-3.14","toolchain":"uv or pip","testCommand":"python -m unittest discover -v"},
    {"name":"ores-otel-log-go-test","language":"go","runtime":"Go 1.24+","toolchain":"go","testCommand":"go test -race ./..."},
    {"name":"ores-otel-log-rust-test","language":"rust","runtime":"Rust stable, beta, and MSRV","toolchain":"cargo","testCommand":"cargo test --all-features && cargo clippy --all-targets --all-features -- -D warnings"},
    {"name":"ores-otel-log-java-test","language":"java","runtime":"JDK 21 and 25","toolchain":"Maven","testCommand":"mvn --batch-mode --no-transfer-progress verify"},
    {"name":"ores-otel-log-dart-test","language":"dart","runtime":"Dart stable and Flutter stable","toolchain":"dart and flutter","testCommand":"dart test && dart analyze"},
    {"name":"ores-otel-log-gleam-test","language":"gleam","runtime":"Gleam on OTP","toolchain":"gleam","testCommand":"gleam format --check src test && gleam test"},
    {"name":"ores-otel-log-erlang-test","language":"erlang","runtime":"Erlang/OTP","toolchain":"rebar3","testCommand":"rebar3 as test do compile, eunit"},
    {"name":"ores-otel-log-elixir-test","language":"elixir","runtime":"Elixir on OTP","toolchain":"mix","testCommand":"mix format --check-formatted && mix test --warnings-as-errors"},
    {"name":"ores-otel-log-ruby-test","language":"ruby","runtime":"Ruby 3.2-3.5","toolchain":"bundler","testCommand":"bundle exec rake test"},
    {"name":"ores-otel-log-wasm-test","language":"wasm","runtime":"wasmtime and browser WebAssembly","toolchain":"cargo, wasm-tools, wasmtime","testCommand":"cargo test && wasm-tools validate target/wasm32-wasip2/release/*.wasm"},
    {"name":"ores-otel-log-wire-interop-test","language":"nodejs","runtime":"Cross-language fixture comparator","toolchain":"Node.js and Docker","testCommand":"npm ci && npm test"}
  ]
}
